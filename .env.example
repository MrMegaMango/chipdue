# Copy this file to .env.local. Never commit the copy or real credentials.
# The placeholders below are intentionally invalid.
# The legacy CARDDUE_* prefix remains compatibility-stable after the ChipDue product rename.
PLAID_CLIENT_ID=replace_with_your_plaid_client_id
PLAID_SECRET=replace_with_your_plaid_secret

# Use sandbox until you have reviewed the privacy model and tested locally.
# Allowed values: sandbox, production
PLAID_ENV=sandbox

# Optional. The default is your operating system's private application-data directory.
# CARDDUE_DATA_DIR=/absolute/path/outside/this/git/checkout

# Private cloud mode is opt-in and requires every value below. Generate the key and
# password hash with `npm run cloud:secrets`; never paste the recovery bundle here.
# Set these only in Vercel's Production environment, never Preview or Development.
# CARDDUE_MODE=cloud
# Use a direct, unpooled Neon runtime-role URL with exactly one sslmode=require
# or sslmode=verify-full parameter. Hostnames ending in -pooler are rejected.
# DATABASE_URL=replace_with_the_direct_neon_runtime_role_connection_string
# CARDDUE_MASTER_KEY=replace_with_a_32_byte_base64url_key
# Optional only because password mode is the backward-compatible default.
# Allowed values: password, google
# CARDDUE_AUTH_MODE=password
# CARDDUE_OWNER_PASSWORD_HASH=replace_with_a_generated_scrypt_hash
# CARDDUE_ALLOWED_HOSTS=replace_with_your_exact_production_host
# CARDDUE_SESSION_TTL_HOURS=24
# CARDDUE_ADMIN_EMAIL=replace_with_the_access_request_recipient

# Google sign-in is optional in password mode. Set both values or neither, then link
# only after password login. Google-only mode requires both, forbids
# CARDDUE_OWNER_PASSWORD_HASH, and has no password endpoint.
# CARDDUE_GOOGLE_CLIENT_ID=replace_with_your_google_oauth_client_id
# CARDDUE_GOOGLE_CLIENT_SECRET=replace_with_your_google_oauth_client_secret

# Google-only first-owner setup is disabled when this value is absent. Generate a
# fresh token/verifier bundle outside the checkout with `npm run google:bootstrap`;
# configure only its verifier here, paste its token only into ChipDue's setup form,
# then remove this variable and redeploy immediately after setup succeeds.
# CARDDUE_GOOGLE_BOOTSTRAP_HASH=replace_with_a_generated_sha256_bootstrap_hash
