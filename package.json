{
	"name": "carddue",
	"private": true,
	"version": "0.0.1",
	"description": "A privacy-first credit card due-date tracker with local and single-owner cloud modes.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "node scripts/build-vercel.mjs",
		"build:vercel": "node scripts/build-vercel.mjs --vercel",
		"start": "node --env-file-if-exists=.env.local scripts/start-local.mjs",
		"preview": "vite preview --host 127.0.0.1",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test": "npm run test:unit",
		"cloud:migrate": "node scripts/migrate-cloud.mjs",
		"cloud:secrets": "node scripts/generate-cloud-secrets.mjs",
		"cloud:verify": "node scripts/verify-cloud-runtime.mjs",
		"privacy:init": "node scripts/init-privacy-denylist.mjs",
		"privacy:check": "node scripts/privacy-check.mjs",
		"ci": "npm run privacy:check && npm run lint && npm run check && npm test && npm run build && npm run build:vercel"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"better-sqlite3": "^13.0.3",
		"jose": "^6.2.10",
		"plaid": "^46.0.0",
		"zod": "^4.4.3"
	}
}
